{
  "manifest_version": 3,
  "name": "YouTube Auto Pause",
  "version": "2.0.0",
  "description": "Instantly pauses YouTube videos when switching tabs and resumes when returning",
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}